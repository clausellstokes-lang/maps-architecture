{
  "name": "plat-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "PLAT, the settlement map generator: the build workspace (milestone M0).",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "install:frozen": "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 corepack pnpm install --frozen-lockfile",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "lint": "node scripts/lint.mjs",
    "bench": "tsx --conditions=plat-source scripts/bench.mjs",
    "bench:calibrate": "tsx --conditions=plat-source scripts/bench.mjs calibrate",
    "bench:timing-phase": "tsx --conditions=plat-source scripts/bench.mjs timing-phase",
    "tier:pr": "tsx --conditions=plat-source scripts/bench.mjs tier:pr",
    "tier:nightly": "tsx --conditions=plat-source scripts/bench.mjs tier:nightly",
    "tier:milestone": "tsx --conditions=plat-source scripts/bench.mjs tier:milestone",
    "vendor:verify": "node tools/vendor/verify.mjs",
    "notices": "node tools/notices/generate.mjs",
    "notices:check": "node tools/notices/generate.mjs --check",
    "browsers:check": "node tools/scaffold/launch-browsers.mjs"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "playwright-core": "1.60.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
