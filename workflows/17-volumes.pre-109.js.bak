  phases: [
    { title: 'Architect', detail: 'one architect per volume writes it to build depth' },
    { title: 'Critique', detail: 'one red-team critic per volume: buildability, owner fidelity, coherence, parity, lifecycle, performance, UX, clean-room' },
    { title: 'Revise', detail: 'the architect seat revises: blockers and majors fixed, minors fixed or put on the fix list' },
    { title: 'Integrate', detail: 'cross-volume coherence, base change requests as amendments f, clean-room scan; then the index, the owner summary and the bundle' },
