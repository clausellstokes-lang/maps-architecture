  { n: 12, slug: 'calibration', title: 'Calibration, reconciliation and parity measurement — how the built generator is tuned against the references and later the corpus', base: '§13.5 (reference-parity metrics and the numbers-only baseline file), §13.6 (the owner side-by-side), §13.7 (thresholds without a source), §13.9 (the corpus-calibration interface), §16 M-1, §17.1 (what the builders may read), item 69 (the palette exception)', research: 'docs/CONFIDENCE.md, docs/validation/coverage-audit-*.md, captures/mfcg/exports-2026-09-25/README.md and exports-sweep-2026-09-25/README.md (numbers only), docs/validation/bench/README.md, partitioned/README.md ONLY (the corpus stays walled off: design the machinery and the process, read no plate or corpus row)', focus: 'the calibration harness end to end: the baselines file and how numbers (never reference data) cross the firewall, the metric suite per reference and per rung, the capture-and-measure loop, tuning runs as table-version bumps with declared shifts and goldens, the owner side-by-side sittings, and the later corpus reconciliation as a process (what it may change — defaults and bands — and what it may not — the base stays the base), with the evidence rules (possibility versus prevalence) and the acceptance rules' },
]

const ARCH_SCHEMA = { type: 'object', properties: { key: { type: 'string' }, file: { type: 'string' }, lines: { type: 'number' }, decisions: { type: 'number' }, base_change_requests: { type: 'number' }, owner_questions: { type: 'array', items: { type: 'string' } }, open: { type: 'array', items: { type: 'string' } } }, required: ['key', 'file', 'lines', 'decisions', 'base_change_requests', 'owner_questions', 'open'] }
const CRIT_SCHEMA = { type: 'object', properties: { key: { type: 'string' }, file: { type: 'string' }, findings: { type: 'array', items: { type: 'object', properties: { id: { type: 'string' }, severity: { type: 'string', enum: ['blocker', 'major', 'minor'] }, lens: { type: 'string' }, claim: { type: 'string' }, required_change: { type: 'string' } }, required: ['id', 'severity', 'lens', 'claim', 'required_change'] } } }, required: ['key', 'file', 'findings'] }
const REV_SCHEMA = { type: 'object', properties: { key: { type: 'string' }, file: { type: 'string' }, fixed: { type: 'number' }, invalid: { type: 'number' }, fix_list: { type: 'number' }, lines: { type: 'number' } }, required: ['key', 'file', 'fixed', 'invalid', 'fix_list', 'lines'] }
const INT_SCHEMA = { type: 'object', properties: { file: { type: 'string' }, headline: { type: 'string' }, conflicts_resolved: { type: 'number' }, base_amendments: { type: 'number' }, clean_room_hits_fixed: { type: 'number' }, owner_questions: { type: 'array', items: { type: 'string' } }, total_estimate_pw: { type: 'string' } }, required: ['file', 'headline', 'conflicts_resolved', 'base_amendments', 'clean_room_hits_fixed', 'owner_questions', 'total_estimate_pw'] }

const vfile = (v) => `${DIR}/V${String(v.n).padStart(2, '0')}-${v.slug}.md`
const SELECTED = ARGS.volumes ? VOLUMES.filter((v) => ARGS.volumes.includes(v.slug)) : VOLUMES
log(`volumes: ${SELECTED.length} (${SELECTED.map((v) => v.slug).join(', ')}); ${MAX_LANES} lanes; ${STANDIN ? 'Opus stand-ins' : 'Fable'}`)

const results = await pipeline(SELECTED,
  (v) => seat(`${GROUND}

LANE volumes/V${v.n}-${v.slug}. You are the ARCHITECT of design volume ${v.n}: ${v.title}. Output: ${vfile(v)}. The base sections and pending items it builds on (read them whole first): ${v.base}. Research inputs (read what bears on the design; firewall rules apply): ${v.research}. What the volume must settle at build depth: ${v.focus}. Also read docs/DEFINITION.md, docs/OWNER-INSTRUCTIONS-2026-09-25.md, the design's one-page summary, §1, §14 and §16, and any docs/retrovalidation/*.md finding that names your subject. Write the volume in the VOLUME STRUCTURE; leave section 13 with the heading only (the revision fills it).`, `volumes/V${v.n}-${v.slug}`, 'Architect', ARCH_SCHEMA),
  (a, v) => seat(`${GROUND}

LANE volumes/critique-V${v.n}. You are the RED-TEAM CRITIC of design volume ${v.n} (${v.title}), file ${vfile(v)} (its architect reported: ${JSON.stringify(a || {})}). Read the volume whole, then the base sections it builds on (${v.base}) and the owner rules. Find what is wrong, missing or unbuildable, through these lenses: (1) BUILDABILITY — every place an implementer holding only the base and this volume would have to guess (a missing type, unit, constant, step, failure case, interface or test); (2) OWNER FIDELITY — each owner rule the subject touches, quoted, against the mechanism; (3) COHERENCE AND WIRING — contradictions, restated base facts, base hooks misused or missing (a base change request that should exist and does not), and every piece that is not wired both ways (an orphan output, a dangling input, a table nothing reads, an edit kind without its tool, lifecycle or undo, an entity not rendered or exported, a dossier fact with no traced field); (4) PARITY — every capability of the reference that owns this subject (from the research inputs: ${v.research}) reached or consciously improved; (5) LIFECYCLE AND DETERMINISM — every new state through create, read, persist, regenerate, undo, migrate; seeds and streams; (6) PERFORMANCE — budgets at the metropolis rung; (7) CASUAL-USER UX where the subject has a surface (item 101's rules); (8) CLEAN-ROOM — any reference identifier, code, word list or table. Severity: blocker (cannot be built or violates an owner rule), major (a wrong or missing mechanism), minor. Every finding carries an exact required change. Write docs/volumes/critique/V${String(v.n).padStart(2, '0')}.md and return the findings.`, `volumes/critique-V${v.n}`, 'Critique', CRIT_SCHEMA),
  (c, v) => seat(`${GROUND}

LANE volumes/revise-V${v.n}. You REVISE design volume ${v.n} (${v.title}), file ${vfile(v)}, against its critique docs/volumes/critique/V${String(v.n).padStart(2, '0')}.md: ${JSON.stringify((c && c.findings) || [])}. Fix every blocker and major in the volume itself (edit the volume file in place — it is yours; keep the PROGRESS ledger current); fix minors that are cheap; a finding you judge wrong is ruled INVALID with the evidence; per the owner's instruction ("if we need to fix anything just do it down the line"), a minor you do not fix goes on section 13's Fix list with its reason. Append to the critique file a disposition table (finding id, FIXED / INVALID / FIX-LIST, where). Return the counts.`, `volumes/revise-V${v.n}`, 'Revise', REV_SCHEMA),
)
const done = results.filter(Boolean)
log(`volumes revised: ${done.length}/${SELECTED.length}; fixed ${done.reduce((n, r) => n + r.fixed, 0)}, invalid ${done.reduce((n, r) => n + r.invalid, 0)}, on fix lists ${done.reduce((n, r) => n + r.fix_list, 0)}`)
if (ARGS.stopAfter === 'revise') return { volumes: done }

phase('Integrate')
const integ = await seat(`${GROUND}

LANE volumes/_integrate. You INTEGRATE the design volumes (the chief architect's seat). FIRST, THE BUNDLED OWNER RULES: check that every part of items 102, 103 (with (f)), 104 (with (h), its (3) as revised), 105, 106, 107, 108 and the island-shadow expectation (J98) that the NEW OWNER RULES paragraph assigns to a volume is designed in that volume at build depth; write any missing part into the volume yourself (append, with an Integration note), and never copy g's base mechanism into f — cite the g item instead. Read every ${DIR}/V*.md (sections 0, 1, 1b, 2, 9, 10, 11 whole; the rest where two volumes meet) and docs/volumes/critique/*.md. Then: (1) CROSS-VOLUME COHERENCE — where two volumes define the same thing differently, share a record, or assume each other (neighbourhoods and buildings; buildings and interiors; underground and neighbourhoods; sky and neighbourhoods; evolution and everything; the application and the clerk; content and everything; the village and the base; SettlementForge and content), decide, correct the volumes in place (append a dated "Integration notes" section to each volume changed, stating what changed and why) and record each decision as J-VI.<n>; (2) BASE CHANGE REQUESTS — collect every volume section 10, deduplicate, resolve conflicts, and write docs/AMENDMENTS-2026-09-28f.md: numbered items from 110, each with the base section, the change (old text quoted once and new text, or the mechanism), the volumes that need it, and BASE or STAGED — NOT applied (the coherence pass applies them); (3) CLEAN-ROOM SCAN — grep every volume for reference identifiers (the class and method names listed in research/findings/code-impact.md and in docs/retrovalidation/pipeline-content.md finding RV-pc-2, and any CamelCase identifier that is not ours), reword every hit in place, and list them. Write ${DIR}/_integrate.md. Log the LANDED line.`, 'volumes/_integrate', 'Integrate', INT_SCHEMA)

// ───────── Reconcile the seams until nothing material is left (owner, 2026-09-28: "due multiple reconciliation rounds until there is nothing material left") ─────────
const MATERIAL = (i) => i.severity === 'blocker' || i.severity === 'major'
const CAP = ARGS.maxRounds || 6
const SEAM_SCHEMA = { type: 'object', properties: { key: { type: 'string' }, file: { type: 'string' }, issues: { type: 'array', items: { type: 'object', properties: { id: { type: 'string' }, severity: { type: 'string', enum: ['blocker', 'major', 'minor'] }, kind: { type: 'string' }, claim: { type: 'string' }, required_change: { type: 'string' }, owner: { type: 'string' } }, required: ['id', 'severity', 'kind', 'claim', 'required_change', 'owner'] } } }, required: ['key', 'file', 'issues'] }
const SEAMS = [
  { key: 'stage2-3', vols: ['V01', 'V02', 'V03'], what: 'neighbourhoods, buildings and interiors: blocks to plots to buildings to rooms, one record chain, one elaboration ladder, one set of classes' },
  { key: 'layers', vols: ['V04', 'V05', 'V01'], what: 'the underground and the sky against the neighbourhoods they carry or shadow' },
  { key: 'time', vols: ['V06', 'V01', 'V02', 'V03', 'V04', 'V05', 'V07'], what: 'evolution against every stage it changes: every piece of state it touches has its epoch behaviour, its transition stages and its undo' },
  { key: 'settlements', vols: ['V07', 'V08', 'V11'], what: 'the village, the SettlementForge stage and the content tables: every dossier kind at every size lands in a class row, the small-settlement hand-off, the ladders meeting' },
  { key: 'surfaces', vols: ['V09', 'V10', 'V08'], what: 'the application, the clerk and the host: one tool vocabulary, one preview protocol, one knowledge rule, the host clerk seam' },
  { key: 'content-calibration', vols: ['V11', 'V12', 'V02', 'V06'], what: 'every table any volume reads exists in the content system with its rows; calibration tunes those tables and no other' },
]
const vfileByKey = (k) => { const v = VOLUMES.find((x) => `V${String(x.n).padStart(2, '0')}` === k); return v ? vfile(v) : null }
const normOwner = (o) => { const t = String(o || '').toUpperCase(); if (t.includes('BASE')) return 'BASE-F'; const m = t.match(/V\s*0?(\d{1,2})/); if (m && Number(m[1]) >= 1 && Number(m[1]) <= 12) return `V${String(Number(m[1])).padStart(2, '0')}`; return null }
let unrouted = []
let round = 0
let history = []
let material = []
let seams = SEAMS
while (true) {
  phase('Reconcile')
  const checks = (await parallel(seams.map((sm) => () => seat(`${GROUND}

LANE volumes/seam-${sm.key}-r${round}. You CHECK A SEAM between design volumes — ${sm.what}. Read whole: ${sm.vols.map(vfileByKey).join(', ')}, the base sections they share, ${DIR}/_integrate.md and docs/AMENDMENTS-2026-09-28f.md. Find every place the volumes contradict each other or the base, restate each other instead of citing, leave a piece unwired across the seam (one side produces what the other never consumes, or consumes what the other never produces), disagree on a term, an id, a unit or a record, or disagree with the base change requests. ${round > 0 ? `This is reconciliation round ${round}: first re-check every issue the previous round raised on this seam (docs/volumes/critique/seam-${sm.key}-r${round - 1}.md) — each must now be fixed — then sweep the whole seam again, since repairs elsewhere can break it.` : 'Sample nothing.'} Severity: blocker, major (a contradiction or an unwired piece that a builder would hit), minor (wording). Each issue names its owning volume (V01…V12, or BASE-F for a base change request that must change) and an exact required change. Write docs/volumes/critique/seam-${sm.key}-r${round}.md.`, `volumes/seam-${sm.key}-r${round}`, 'Reconcile', SEAM_SCHEMA)))).filter(Boolean)
  const issues = checks.filter(Boolean).flatMap((c) => c.issues || []).filter(Boolean).map((i) => ({ ...i, owner: normOwner(i.owner) || i.owner }))
  material = issues.filter(MATERIAL)
  history.push(material.length)
  log(`seam round ${round}: ${issues.length} issues, ${material.length} material`)
  if (!material.length) break
  if (round >= CAP) { log(`CAP of ${CAP} seam rounds reached with ${material.length} material issues — they go to the coherence pass and the owner summary`); break }
  round++
  let rulings = ''
  if (history.length >= 3 && history[history.length - 1] >= history[history.length - 3]) {
    const adj = await seat(`${GROUND}

LANE volumes/adjudicate-r${round}. The material seam issue count has not fallen for two rounds (${JSON.stringify(history)}). Read the seam files of the last three rounds (docs/volumes/critique/seam-*-r*.md) and the volumes concerned; find the issues that recur or ping-pong between volumes, and write BINDING RULINGS to docs/volumes/critique/adjudication-r${round}.md (the single correct decision, the volume that states it, what every other volume references). Current material issues: ${JSON.stringify(material)}.`, `volumes/adjudicate-r${round}`, 'Reconcile', { type: 'object', properties: { file: { type: 'string' }, rulings: { type: 'number' } }, required: ['file', 'rulings'] })
    if (adj) rulings = ` BINDING RULINGS: apply ${adj.file} where it concerns your volume.`
  }
  const owners = [...new Set(issues.map((i) => i.owner))].filter((o) => o === 'BASE-F' || vfileByKey(o))
  unrouted = issues.filter((i) => !owners.includes(i.owner))
  if (unrouted.length) log(`seam issues with an owner that is neither a volume nor BASE-F: ${unrouted.length} — handed to the finalize seat`)
  await parallel(owners.map((o) => () => seat(`${GROUND}

LANE volumes/reconcile-${o}-r${round}. You RECONCILE ${o === 'BASE-F' ? 'the base change requests docs/AMENDMENTS-2026-09-28f.md (edit the items in place; keep their numbers; add new items after the last)' : `the design volume ${vfileByKey(o)} (edit it in place; keep its PROGRESS ledger and structure)`} against these seam issues: ${JSON.stringify(issues.filter((i) => i.owner === o))}.${rulings} Fix every blocker and major; fix minors that are cheap; a minor you leave goes on the volume's Fix list (section 13) with its reason. Append a dated "Reconciliation round ${round}" note to the file listing what changed. Return the counts.`, `volumes/reconcile-${o}-r${round}`, 'Reconcile', REV_SCHEMA)))
  const touched = new Set(owners)
  seams = SEAMS
  if (seams.every((sm) => !sm.vols.some((k) => touched.has(k)))) seams = SEAMS
}

phase('Integrate')
const fin = await seat(`${GROUND}

LANE volumes/_finalize. You FINALIZE the volumes after ${round} reconciliation round(s) (material issues left: ${material.length}${material.length ? ` — ${JSON.stringify(material)}` : ''}; issues no volume owned: ${JSON.stringify(unrouted)} — route and fix each yourself in the volume it concerns). Read every ${DIR}/V*.md, ${DIR}/_integrate.md, docs/volumes/critique/seam-*.md and adjudication files, and docs/AMENDMENTS-2026-09-28f.md. Then: (1) refresh docs/AMENDMENTS-2026-09-28f.md with any base change the reconciliation rounds added or changed (keep numbers); (2) THE INDEX — write ${DIR}/INDEX.md: the product map (base plus twelve volumes), the WIRING between volumes and the base (which hooks each volume plugs into and what each feeds), the dependency graph between volumes and base milestones, the combined build order after §16's M5 with estimates in person-weeks and the total, the risks and spikes across volumes, every owner question with its recommendation; (3) THE OWNER SUMMARY — write ${DIR}/SUMMARY.md in PLAIN LANGUAGE for the owner (who does not code): what each volume makes possible, what it will feel like, the order they would be built in, how big the whole program now is, how many reconciliation rounds it took and what they fixed, what was left on fix lists and why it is immaterial, and what decisions (if any) are theirs; (4) THE BUNDLE — run python3 tools/bundle_architecture.py then --check; never edit the bundle by hand. Then log the LANDED line and a hand-log entry with python3 tools/progress.py --log "…".`, 'volumes/_finalize', 'Integrate', INT_SCHEMA)

return { volumes: done.map((r) => ({ key: r.key, lines: r.lines, fixed: r.fixed, fix_list: r.fix_list })), integration: integ, seam_rounds: round, seam_history: history, material_left: material.length, finalize: fin }
