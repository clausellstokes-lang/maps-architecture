export const meta = {
  name: 'ftg-signed-in',
  description: 'J163: the five remaining FTG towns (slots 1-5) created one after another in the owner signed-in free account, each recorded and checked like day 1, then one independent verifier',
  phases: [
    { title: 'Capture', detail: 'one recording seat per slot, in order; stop where the account limit stops' },
    { title: 'Verify', detail: 'one Opus verifier re-runs every landed slot check' },
  ],
}

const ARGS = (typeof args === 'object' && args) ? args : {}
const ROOT = ARGS.root || '/Users/cstokes/Desktop/Maps'
const SCRATCH = ARGS.scratch || '/tmp/maps-scratch/ftg'
const MODEL = ARGS.model || 'opus'
const SLOTS = ARGS.slots || [1, 2, 3, 4, 5]
const seat = (prompt, label, phaseName, schema) => agent(prompt, { label, phase: phaseName, schema, agentType: 'general-purpose', model: MODEL })

const GROUND = `PROJECT (root ${ROOT}). Milestone M-1 of the Maps program records six Fantasy Town Generator (FTG) towns (docs/calibration/M-1-plan.md section 2.1; the slots in research/baselines/plan.json; the procedure in research/baselines/ftg_capture_checklist.md and docs/calibration/E02-ftg-captures.md sections 3–5, written by day 1's seat, slot 0, which landed 2026-10-03 17:23 UTC as a no-account temporary settlement). YOU ARE A RESEARCH-SIDE SEAT: you may read research/, captures/, profiler/ and docs/; you write only captures/ftg/<stamp>/, research/baselines/ (the checklist and its scripts) and docs/calibration/ (E02 and results/); never plat/, never the design, and NO git command that changes state (the session commits). THE OWNER'S RULING J163 (2026-10-03): the owner has signed in to FTG with their own Google account in the persistent profile profiler/.profiles/ftg and approved creating the five remaining towns today in that signed-in FREE account, one after another. Hard limits: never upgrade, subscribe, pay or open a premium or Patreon flow; never sign out, switch accounts, change account or site settings, delete, rename or share any settlement; on a cookie or consent notice choose decline non-essential and accept nothing else; if the site shows a settlement limit, a payment or upgrade prompt, new terms, a sign-in or Google prompt (the session expired), or anything else outside this list, STOP without clicking it, take a shot, and report it in owner_notes. PRIVACY: the owner's email, name, account or user ids, tokens and cookie values are NEVER written into any file outside captures/ (docs/ and research/ are pushed to GitHub); inside captures/ write them nowhere you choose to write (the session recording itself stays local and is never quoted); in records say only "the owner's signed-in free account". THE MACHINE: the owner's Mac (Node 24, Chrome 154, Python 3.9); M0 build seats run in plat/ at the same time; about 12 GB free — stop under 1 GB. Use the isolated runner of checklist step A3 (your own copies in ${SCRATCH}/runner/, your own port and session file) so no other lane's browser is touched. WORKING RULES: CHECKPOINT lines in docs/lane-events.log at least every twenty minutes ("$(date '+%Y-%m-%d %H:%M') <lane key> CHECKPOINT <done; next>"); write your exact structured result to docs/calibration/results/<lane id>.json, then "<date> <lane key> LANDED <files>", and make your final message that JSON. RESUME RULE: a result file plus a LANDED line for your exact lane key means return the file's JSON without redoing. CONTINUE RULE: files without that line mean continue from them (never create a second settlement for a slot whose create already happened — check the capture folder and the network index first). Label conclusions CONFIRMED or PLAUSIBLE.`

const SLOT_SCHEMA = { type: 'object', properties: { slot: { type: 'number' }, status: { type: 'string', enum: ['landed', 'stopped', 'failed'] }, capture: { type: 'string' }, checks: { type: 'array', items: { type: 'object', properties: { check: { type: 'string' }, passed: { type: 'boolean' }, receipt: { type: 'string' } }, required: ['check', 'passed', 'receipt'] } }, account_limit: { type: 'string' }, owner_notes: { type: 'array', items: { type: 'string' } }, notes: { type: 'array', items: { type: 'string' } } }, required: ['slot', 'status', 'capture', 'checks', 'account_limit', 'owner_notes', 'notes'] }
const VERIFY_SCHEMA = { type: 'object', properties: { slots: { type: 'array', items: { type: 'object', properties: { slot: { type: 'number' }, verdict: { type: 'string', enum: ['confirmed', 'refuted', 'partial'] }, problems: { type: 'array', items: { type: 'string' } } }, required: ['slot', 'verdict', 'problems'] } }, privacy_ok: { type: 'boolean' }, privacy_notes: { type: 'array', items: { type: 'string' } } }, required: ['slots', 'privacy_ok', 'privacy_notes'] }

const slotPrompt = (n, first) => `${GROUND}

LANE m1/W-02-slot${n}. You create and record slot ${n} (plan section 2.1: day ${n + 1}'s size and water options, every other form value as day 1). ${first ? 'You are the FIRST signed-in seat: before creating anything, start the session, read the landing and the account\'s settlements view with drive.mjs text and shot (read only; click nothing that changes anything), and record in E02 a new section "Signed-in captures (J163)": how the signed-in flow differs from day 1\'s guest flow (the create control\'s label, the form, where the payload arrives) and the free account\'s settlement limit as the site states it (a number and its wording, no identifiers); then write the signed-in steps as a new section H of research/baselines/ftg_capture_checklist.md for the seats after you. If the stated limit leaves fewer than five creates, record it and create only what it allows across the run (you create one). ' : 'Read section H of research/baselines/ftg_capture_checklist.md and E02\'s "Signed-in captures (J163)" section first, and follow them. '}Then create exactly ONE settlement for slot ${n}: a text and a shot before every click, the create control clicked only when it is the one hit-testable match, the payload intercepted as on day 1. Then run python3 research/baselines/ftg_capture_post.py <stamp> --slot ${n} --notes <notes> (all its checks must pass, the size-dependent values compared with day 1's), bind the slot with python3 research/baselines/plan.py --bind-ftg ${n}=<stamp> and --check, append a "Slot ${n} (signed in)" section to E02 and an entry to E02-ftg-captures.json, stop the session with drive.mjs stop, and run df. Return landed only if every check passed; stopped (with the reason and a shot) if the site stopped you; failed otherwise. Result file id: W-02-slot${n}.`

const verifyPrompt = (landed) => `${GROUND}

LANE m1/W-02-signed-in-verify. You are the INDEPENDENT VERIFIER of the signed-in FTG captures (slots ${JSON.stringify(landed)}), separate from the seats that made them; you touch no website. For each slot: re-decode the payload with tools/pb_raw.py, re-run research/baselines/ftg_capture_post.py on its capture folder and confirm every check, confirm the request's size and water keys equal the slot's and nothing else differs from day 1 beyond the class E02 names, and confirm plan.py --check binds the slots in order. Then the PRIVACY CHECK: search every file the seats wrote or changed outside captures/ (docs/calibration/, research/baselines/, docs/lane-events.log) for an email address, a Google or FTG account or user id, a token or a cookie value, and report privacy_ok false with the paths if any is found. Result file id: W-02-signed-in-verify.`

const results = []
for (let i = 0; i < SLOTS.length; i++) {
  const n = SLOTS[i]
  const r = await seat(slotPrompt(n, i === 0), `m1/W-02-slot${n}`, 'Capture', SLOT_SCHEMA)
  results.push(r)
  if (!r || r.status !== 'landed') { log(`slot ${n}: ${r ? r.status : 'no result'}; stopping the run`); break }
  log(`slot ${n} landed: ${r.capture}`)
}
const landed = results.filter((r) => r && r.status === 'landed').map((r) => r.slot)
const verify = landed.length ? await seat(verifyPrompt(landed), 'm1/W-02-signed-in-verify', 'Verify', VERIFY_SCHEMA) : null
return { results, verify }
